# Frontend Environment Configuration Template
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle and are publicly visible in the browser.
# NEVER place secret credentials, private API keys, or passwords in this file or any VITE_* variable.

# Backend API base URL (reserved for Phase 1 Step 6 Integration)
VITE_API_BASE_URL=http://127.0.0.1:8000
