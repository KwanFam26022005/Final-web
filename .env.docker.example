# Docker Compose Environment Template
# Copy this file to .env.docker for local Docker runtime execution.
# Never commit .env.docker containing actual secret values.

# Application encryption key (generate with: php artisan key:generate --show)
APP_KEY=base64:CHANGE_ME_GENERATE_VALID_APP_KEY_FOR_LOCAL_DOCKER_RUNTIME

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=secret_root_password
DB_USERNAME=final_web_user
DB_PASSWORD=secret_db_password

# Public Frontend API URL (embedded in client build)
VITE_API_BASE_URL=http://127.0.0.1:8000
